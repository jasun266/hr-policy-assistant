# Copy to .env and fill in what you need. Every variable is optional.

# --- Backend (FastAPI) -------------------------------------------------------
# Claude API key. Leave empty to run the scripted demo model (FakeLLM): no cost, no network.
ANTHROPIC_API_KEY=
# Model and reasoning effort used by the agent loop.
HR_AGENT_MODEL=claude-opus-5-5
HR_AGENT_EFFORT=medium
# Max model calls per chat turn before the agent gives up (runaway-loop guard).
HR_AGENT_MAX_STEPS=6
# SQLite file. Relative paths resolve from the directory uvicorn runs in.
# docker-compose overrides this to sqlite:////data/hr.db (a named volume).
DATABASE_URL=sqlite:///./hr.db
# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Pin "today" (YYYY-MM-DD) so demos and screenshots are reproducible. Empty = real date.
HR_TODAY=
# Set to 1 to force the scripted demo model even when an API key is present.
HR_FAKE_LLM=

# --- Frontend (Next.js) ------------------------------------------------------
# Backend URL as seen from the browser. Inlined at build time (next build / docker build arg).
NEXT_PUBLIC_API_URL=http://localhost:8000
